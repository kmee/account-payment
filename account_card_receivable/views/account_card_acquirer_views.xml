<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_card_acquirer_form" model="ir.ui.view">
        <field name="name">account.card.acquirer.form</field>
        <field name="model">account.card.acquirer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Name" /></h1>
                    </div>
                    <group>
                        <group name="identification">
                            <field name="partner_id" />
                            <field name="establishment_code" />
                            <field name="journal_id" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="payment_journal_ids" widget="many2many_tags" readonly="1" />
                        </group>
                        <group name="accounts">
                            <field name="receivable_account_id" />
                            <field name="clearing_account_id" />
                            <field name="fee_account_id" />
                            <field name="anticipation_account_id" />
                            <field name="adjustment_account_id" />
                            <field name="chargeback_account_id" />
                        </group>
                        <group name="rounding">
                            <field name="rounding_installment" />
                            <field name="amount_tolerance" />
                        </group>
                    </group>
                    <field name="rule_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="modality" />
                            <field name="installments_from" />
                            <field name="installments_to" />
                            <field name="brand_ids" widget="many2many_tags" />
                            <field name="fee_percent" />
                            <field name="first_due_days" />
                            <field name="interval_days" />
                            <field name="single_settlement" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_card_acquirer_list" model="ir.ui.view">
        <field name="name">account.card.acquirer.list</field>
        <field name="model">account.card.acquirer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="partner_id" />
                <field name="establishment_code" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="action_account_card_acquirer" model="ir.actions.act_window">
        <field name="name">Card Acquirers</field>
        <field name="res_model">account.card.acquirer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
