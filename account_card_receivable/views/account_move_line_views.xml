<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_line_card_list" model="ir.ui.view">
        <field name="name">account.move.line.card.list</field>
        <field name="model">account.move.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="date_maturity" />
                <field name="card_acquirer_id" />
                <field name="card_payment_id" />
                <field name="card_sale_date" />
                <field name="card_modality" optional="show" />
                <field name="card_brand_id" optional="show" />
                <field name="card_acquirer_reference" />
                <field name="card_authorization_code" optional="hide" />
                <field name="card_installment" />
                <field name="card_installment_count" />
                <field name="debit" sum="Total" />
                <field name="amount_residual" sum="Open" />
                <field name="company_currency_id" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="action_account_card_receivable" model="ir.actions.act_window">
        <field name="name">Card Receivables</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="account_move_line_card_list" />
        <field
            name="domain"
        >[('card_acquirer_id', '!=', False), ('debit', '>', 0), ('parent_state', '=', 'posted')]</field>
        <field name="context">{'search_default_unreconciled': 1}</field>
    </record>
</odoo>
