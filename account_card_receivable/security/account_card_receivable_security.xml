    <record id="account_card_statement_line_company_rule" model="ir.rule">
        <field name="name">Card acquirer statement line: multi-company</field>
        <field name="model_id" ref="model_account_card_statement_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
